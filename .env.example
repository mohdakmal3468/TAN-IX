# ==============================================================================
# TAN-IX (Tannery Intelligent eXchange) - Environment Variables
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' (in the same root directory)
# 2. Add your Google Gemini API key
# 3. If you do not have Google Cloud Firestore or BigQuery set up yet,
#    keep USE_MOCK_DATA=true to test everything locally with pre-seeded data!
# ==============================================================================

# Gemini Model Configuration
GEMINI_API_KEY="AQ.Ab8RN6I8l23wqZI9C7a8IHYMUUAF64OylfNPX6Y0PvoTL9QH6"
GEMINI_MODEL=gemini-2.5-flash

# Google Cloud Project Configuration
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GCP_PROJECT_ID=your-tan-ix
FIRESTORE_DATABASE=(database=tanix007)
BIGQUERY_DATASET=up_leather_logistics

# Discord Webhook URL for Human-in-the-Loop approval alerts
# (Create a webhook in any Discord server channel: Server Settings -> Integrations -> Webhooks)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/1557232643865583657/uk62gpVAx7N9dSg-qp2wnHjWv8udXPwaiZfS_UEi6Dtj3VbGd8ORXYuDWg8xQUOFwe9p

# Fast & offline mode for testing without requiring active GCP billing
USE_MOCK_DATA=true

# Server Configuration
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
STREAMLIT_PORT=8501
